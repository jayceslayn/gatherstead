<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- Keep the core driver and Azure auth add-on aligned: their extension assemblies are versioned
         together, and mismatches cause SqlAuthenticationProviderManager initialization to fail. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- MDS 7.x provides the Entra ID auth providers (Active Directory Default, etc.) in this
         add-on package. Required for the "Authentication=Active Directory Default" connection string;
         it registers the providers automatically with no code changes. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.SqlClient.AlwaysEncrypted.AzureKeyVaultProvider" Version="7.1.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

</Project>
